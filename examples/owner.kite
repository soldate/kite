special type memory {
    list node_objects;
    list box_objects;

    pointer on_heap(int size, int type) {
        pointer p = allocator.alloc(size);

        if (type == node.id) {
            node_objects.add(p);
        } else {
            box_objects.add(p);
        }

        return p;
    }

    void on_delete(pointer p, int type) {
        if (type == node.id) {
            node_objects.remove(p);
        } else {
            box_objects.remove(p);
        }

        allocator.free(p);
    }

    void clean_heap() {
        node_objects.delete_all();
        box_objects.delete_all();
    }
}

special type main {
    void main() {
        node first = node(10);
        node second = node(20);
        box payload = box(30);

        first.value = second.value + payload.value;

        delete second;

        memory.clean_heap();
    }
}

type node {
    int value;

    void init(int v) {
        value = v;
    }
}

type box {
    int value;

    void init(int v) {
        value = v;
    }
}
