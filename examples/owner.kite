type main {
    list heap_objects;

    pointer on_heap(int size) {
        pointer p = bootstrap_alloc(size);

        heap_objects.add(p);
        return p;
    }

    void clean_heap() {
        heap_objects.delete_all();
    }

    void main() {
        node first = node(10);
        node second = node(20);

        first.value = second.value;

        clean_heap();
    }
}

type node {
    int value;

    void init(int v) {
        value = v;
    }
}
