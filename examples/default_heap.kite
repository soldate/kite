type node {
    int value;

    void init(int v) {
        value = v;
    }
}

type main {
    pointer heap0;
    pointer heap1;
    int heap_count;

    pointer on_heap(int size) {
        pointer p = bootstrap_alloc(size);

        if (heap_count == 0) {
            heap0 = p;
        } else {
            heap1 = p;
        }

        heap_count = heap_count + 1;
        return p;
    }

    void clean_heap() {
        if (heap_count > 0) {
            delete heap0;
        }

        if (heap_count > 1) {
            delete heap1;
        }
    }

    void main() {
        node a = node(10);
        node b = node(20);

        a.value = b.value;

        clean_heap();
    }
}
