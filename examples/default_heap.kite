type node {
    int value;

    void init(int v) {
        value = v;
    }
}

type main {
    list heap_objects;

    pointer on_heap(int size, int type) {
        pointer p = allocator.alloc(size);

        if (type == node.id) {
            heap_objects.add(p);
        }

        return p;
    }

    void clean_heap() {
        heap_objects.delete_all();
    }

    void main() {
        node a = node(10);
        node b = node(20);

        a.value = b.value;

        clean_heap();
    }
}
