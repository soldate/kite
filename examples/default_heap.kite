type node {
    int value;

    void init(int v) {
        value = v;
    }
}

type main {
    pointer_list heap_objects;

    pointer on_heap(int size) {
        pointer p = bootstrap_alloc(size);

        heap_objects.add(p);
        return p;
    }

    void clean_heap() {
        heap_objects.delete_all();
    }

    void main() {
        node a = node(10);
        node b = node(20);

        a.value = b.value;

        clean_heap();
    }
}
