type node {
    int value;

    void init(int v) {
        value = v;
    }
}

type memory {
    pointer on_heap(int size, int type) {
        return allocator.alloc(size);
    }

    void on_delete(pointer p, int type) {
        allocator.free(p);
    }
}

type main {
    void main() {
        node a = node(10);
        node b = a;

        b.value = 20;
        delete a;
    }
}
