special type memory {
    list heap_objects;

    pointer on_heap(int size, int type) {
        pointer p = allocator.alloc(size);
        heap_objects.add(p);
        return p;
    }

    void clean_heap() {
        heap_objects.delete_all();
    }
}

special type main {
    void main() {
        int[] numbers = [5, 7, 0];
        int[3] fixed;

        fixed[0] = numbers[0];
        fixed[1] = numbers[1];
        fixed[2] = fixed[0] + fixed[1];

        if (numbers.length == 3) {
            if (fixed.length == 3) {
                console.write("arrays");
            }
        }

        memory.clean_heap();
    }
}
